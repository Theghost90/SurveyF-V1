// SurveyFlow V1 — database schema.
//
// The models follow the V1 spec. Fields/models marked "ADDED" are not in the spec
// but are required to make a described behaviour correct (see docs/DECISIONS.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  trial
  starter
  growth
  business
}

enum SurveyStatus {
  draft
  active
  paused
  closed
}

enum QuestionType {
  button
  list
  text
  rating
  multi
}

enum GiftType {
  none
  airtime
  momo
  discount
  prize_draw
  custom
}

enum GiftDeliveryMode {
  immediate
  batch
}

// Spec statuses: sent/delivered/started/completed/abandoned/declined.
// ADDED: `queued` (invitation not yet sent) and `failed` (could not be sent) —
// without them "totalSent" cannot be computed correctly.
enum RecipientStatus {
  queued
  sent
  delivered
  started
  completed
  abandoned
  declined
  failed
}

enum GiftStatus {
  pending
  sent
  failed
  // ADDED: participant finished but the owner's wallet could not cover the gift. The participant got a plain
  // thank-you (never a promise we can't keep); the owner can top up and release these.
  unfunded
}

enum SubscriptionStatus {
  trial
  active
  past_due
  suspended
  cancelled
}

enum TransactionStatus {
  pending
  success
  failed
  expired
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String? // null for Google-only accounts
  name              String
  businessName      String
  phone             String
  plan              Plan      @default(trial)
  createdAt         DateTime  @default(now())
  preferredCurrency String    @default("XAF")
  preferredPSP      String?
  country           String    @default("CM")
  locale            String    @default("fr") // ADDED: UI + platform-message language
  trialEndsAt       DateTime? // ADDED
  onboardingDoneAt  DateTime? // ADDED
  // ADDED: prepaid gift wallet. The SURVEY OWNER funds gifts (airtime / Mobile Money), never SurveyFlow.
  // Only ever changed with a guarded UPDATE (see services/wallet.ts), so it cannot go negative.
  giftBalanceFCFA Int @default(0)

  whatsappAccounts WhatsAppAccount[]
  surveys          Survey[]
  contacts         Contact[]
  subscription     Subscription?
  transactions     PaymentTransaction[]
  googleConnection GoogleConnection?
  messageLogs      MessageLog[]
  sheetSyncs       SheetSync[]
  walletEntries    WalletEntry[]
}

model WhatsAppAccount {
  id            String   @id @default(cuid())
  userId        String
  wabaId        String
  phoneNumberId String   @unique
  displayPhone  String? // ADDED
  accessToken   String // AES-256-GCM ciphertext (see lib/crypto.ts) — never plaintext
  status        String   @default("active") // active | error | disconnected
  createdAt     DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates MessageTemplate[]
  surveys   Survey[]

  @@index([userId])
}

// ADDED: WhatsApp templates are per-WABA, so each connected account needs its own
// copies of the invitation/reminder templates, each with its own approval state.
model MessageTemplate {
  id             String   @id @default(cuid())
  accountId      String
  name           String
  language       String // "fr" | "en"
  category       String   @default("UTILITY")
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | PAUSED
  metaTemplateId String?
  reason         String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  account WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name, language])
}

model Survey {
  id               String           @id @default(cuid())
  userId           String
  title            String
  description      String?
  status           SurveyStatus     @default(draft)
  giftType         GiftType         @default(none)
  giftValue        String? // display label, e.g. "500 MB MTN data bundle"
  giftDeliveryMode GiftDeliveryMode @default(immediate)
  createdAt        DateTime         @default(now())
  publishedAt      DateTime?

  // ADDED
  language         String   @default("fr") // language of participant-facing messages
  customThankYou   String? // referenced by the spec's gift code but missing from its schema
  giftAmountFCFA   Int? // numeric value for airtime / momo gifts
  giftMaxCount     Int? // hard cap on gifts, protects the owner's budget
  scheduledAt      DateTime?
  closedAt         DateTime?
  whatsappAccountId String?

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  questions  Question[]
  recipients SurveyRecipient[]
  responses  Response[]
  gifts      GiftDelivery[]
  drawEntries PrizeDrawEntry[]
  sheetSync  SheetSync?

  @@index([userId, status])
}

model Question {
  id       String       @id @default(cuid())
  surveyId String
  order    Int
  text     String
  type     QuestionType
  options  Json? // [{ id, label }]
  required Boolean      @default(true)

  survey    Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([surveyId, order])
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String // E.164 with leading "+", e.g. +237677123456
  tags      Json     @default("[]")
  createdAt DateTime @default(now())

  // ADDED: WhatsApp policy requires opt-in; STOP must be honoured.
  consentAt     DateTime?
  consentSource String?
  optedOutAt    DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients  SurveyRecipient[]
  responses   Response[]
  gifts       GiftDelivery[]
  drawEntries PrizeDrawEntry[]

  @@unique([userId, phone])
}

model SurveyRecipient {
  id                  String          @id @default(cuid())
  surveyId            String
  contactId           String
  status              RecipientStatus @default(queued)
  sentAt              DateTime?
  completedAt         DateTime?
  abandonedAtQuestion Int? // 1-based question number

  // ADDED. `status` is strictly FUNNEL progress and never regresses; delivery work
  // (invitations, reminders) lives in SendJob so that re-sending a reminder to an
  // abandoned participant does not erase them from the "abandoned" count.
  startedAt   DateTime?
  lastError   String?
  waMessageId String? // id of the invitation message (delivery status webhooks)
  remindedAt  DateTime?
  createdAt   DateTime @default(now())

  survey  Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  jobs SendJob[]

  @@unique([surveyId, contactId])
  @@index([surveyId, status])
  @@index([waMessageId])
}

// ADDED: DB-backed outbound queue (claimed with FOR UPDATE SKIP LOCKED).
model SendJob {
  id           String    @id @default(cuid())
  userId       String
  recipientId  String?
  kind         String // invitation | reminder | gift_notice
  status       String    @default("queued") // queued | processing | done | failed
  scheduledFor DateTime  @default(now())
  attempts     Int       @default(0)
  lastError    String?
  lockedAt     DateTime?
  payload      Json?
  createdAt    DateTime  @default(now())

  recipient SurveyRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
}

model Response {
  id         String   @id @default(cuid())
  surveyId   String
  contactId  String
  questionId String
  answer     String // option label, rating "1".."5", free text, or JSON array for multi
  answeredAt DateTime @default(now())

  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([surveyId, contactId, questionId])
  @@index([questionId])
}

// NOTE: the spec's `Session` lives in Redis only (key sf:sess:{phoneNumberId}:{phone}).
// Durable truth is SurveyRecipient + Response, so a lost Redis can be rebuilt from SQL.

model GiftDelivery {
  id           String     @id @default(cuid())
  surveyId     String
  contactId    String
  giftType     GiftType
  giftValue    String?
  status       GiftStatus @default(pending)
  sentAt       DateTime?
  errorMessage String?

  // ADDED
  amountFCFA   Int?
  code         String? // discount code
  providerRef  String?
  attempts     Int      @default(0)
  scheduledFor DateTime @default(now())
  createdAt    DateTime @default(now())

  // ADDED (gift wallet)
  feeFCFA           Int       @default(0) // pass-through fee charged to the owner's wallet on top of amountFCFA
  refundedAt        DateTime? // set when a DEFINITE failure returned amountFCFA+feeFCFA to the wallet (ambiguous failures stay debited)
  notifyViaTemplate Boolean   @default(false) // released after a top-up: the 24h window is closed, so notify with a template

  survey  Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // One gift per participant per survey — gifts move real money, so double delivery
  // from a retried webhook must be impossible at the database level.
  @@unique([surveyId, contactId])
  @@unique([surveyId, code])
  @@index([status, scheduledFor])
}

// ADDED: the spec's `db.addToDrawPool`.
model PrizeDrawEntry {
  id        String   @id @default(cuid())
  surveyId  String
  contactId String
  isWinner  Boolean  @default(false)
  createdAt DateTime @default(now())

  survey  Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([surveyId, contactId])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  plan               Plan
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  paymentMethod      String? // mobile_money | card | bank_transfer
  amountFCFA         Int                @default(0)
  pspProvider        String?
  pspTransactionId   String?

  // ADDED
  interval          String    @default("monthly") // monthly | annual
  cancelAtPeriodEnd Boolean   @default(false)
  graceEndsAt       DateTime?
  reminderSentAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id             String            @id @default(cuid())
  subscriptionId String
  pspProvider    String
  amount         Int
  currency       String
  status         TransactionStatus @default(pending)
  pspReference   String?
  createdAt      DateTime          @default(now())

  // ADDED
  userId      String
  reference   String   @unique // our internal id sent to the PSP
  purpose     String   @default("subscription") // subscription | gift_topup
  plan        Plan? // null for gift top-ups
  interval    String   @default("monthly")
  method      String // mobile_money | card | bank_transfer
  phone       String?
  checkoutUrl String?
  paidAt      DateTime?
  failReason  String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([pspProvider, pspReference])
}

// ADDED: append-only ledger of the gift wallet (audit trail; the balance itself lives on User).
// Idempotency comes from the guarded state transitions that create entries (payment pending→success,
// gift pending→failed, gift unfunded→pending), not from this table.
model WalletEntry {
  id           String   @id @default(cuid())
  userId       String
  deltaFCFA    Int // + top-up / refund, − gift debit
  balanceAfter Int
  kind         String // topup | gift_debit | gift_refund
  refId        String? // PaymentTransaction.id or GiftDelivery.id
  note         String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([refId]) // heldByGift(): a refund sums the ledger rows of ONE gift
}

// ADDED: one row per business-initiated (template) message. This is the unit the
// plan's "WhatsApp messages / month" quota counts — free-form replies inside the
// 24h service window are not counted.
model MessageLog {
  id          String   @id @default(cuid())
  userId      String
  kind        String // invitation | reminder | gift
  waMessageId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ADDED: Google Sheets OAuth.
model GoogleConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  email        String?
  refreshToken String // AES-256-GCM ciphertext
  scope        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SheetSync {
  id            String    @id @default(cuid())
  surveyId      String    @unique
  userId        String
  spreadsheetId String
  spreadsheetUrl String
  autoSync      Boolean   @default(false)
  lastSyncedAt  DateTime?
  rowsSynced    Int       @default(0)
  createdAt     DateTime  @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ADDED: which participants were already appended to the sheet (idempotent re-sync).
model SheetRow {
  id        String   @id @default(cuid())
  surveyId  String
  contactId String
  createdAt DateTime @default(now())

  @@unique([surveyId, contactId])
}
