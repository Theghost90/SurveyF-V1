// SurveyFlow V1 — database schema.
//
// The models follow the V1 spec. Fields/models marked "ADDED" are not in the spec
// but are required to make a described behaviour correct (see docs/DECISIONS.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  trial
  starter
  growth
  business
}

enum SurveyStatus {
  draft
  active
  paused
  closed
}

enum QuestionType {
  button
  list
  text
  rating
  multi
}

enum GiftType {
  none
  airtime
  momo
  discount
  prize_draw
  custom
}

enum GiftDeliveryMode {
  immediate
  batch
}

// Spec statuses: sent/delivered/started/completed/abandoned/declined.
// ADDED: `queued` (invitation not yet sent) and `failed` (could not be sent) —
// without them "totalSent" cannot be computed correctly.
enum RecipientStatus {
  queued
  sent
  delivered
  started
  completed
  abandoned
  declined
  failed
}

enum GiftStatus {
  pending
  sent
  failed
  // ADDED: participant finished but the owner's wallet could not cover the gift. The participant got a plain
  // thank-you (never a promise we can't keep); the owner can top up and release these.
  unfunded
}

enum SubscriptionStatus {
  trial
  active
  past_due
  suspended
  cancelled
}

enum TransactionStatus {
  pending
  success
  failed
  expired
  // Money was received (the provider confirmed it) but a person must decide: underpaid, wrong currency, a lower plan than the one active, or an
  // activation that could not be applied. Never shown as a failure to the customer; resolved with scripts/payments-review.mts.
  review
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String? // null for Google-only accounts
  name              String
  businessName      String
  phone             String
  plan              Plan      @default(trial)
  createdAt         DateTime  @default(now())
  preferredCurrency String    @default("XAF")
  preferredPSP      String?
  country           String    @default("CM")
  locale            String    @default("fr") // ADDED: UI + platform-message language
  trialEndsAt       DateTime? // ADDED
  onboardingDoneAt  DateTime? // ADDED
  // ADDED: prepaid gift wallet. The SURVEY OWNER funds gifts (airtime / Mobile Money), never SurveyFlow.
  // Only ever changed with a guarded UPDATE (see services/wallet.ts), so it cannot go negative.
  // Kept in the OWNER'S currency (whole units, `giftCurrency`); the database column keeps its historical name.
  giftBalance  Int     @default(0) @map("giftBalanceFCFA")
  giftCurrency String? // set by the first top-up and never changed afterwards; null = no wallet money yet
  // ADDED: who the owner is (business | institution | academic), chosen in onboarding. Hook for segment-specific features.
  segment String?

  whatsappAccounts WhatsAppAccount[]
  surveys          Survey[]
  contacts         Contact[]
  subscription     Subscription?
  transactions     PaymentTransaction[]
  googleConnection GoogleConnection?
  messageLogs      MessageLog[]
  sheetSyncs       SheetSync[]
  walletEntries    WalletEntry[]
  funnelEvents     FunnelEvent[]
  botAlerts BotAlert[]
  ownerPhones      OwnerPhone[]
}

model WhatsAppAccount {
  id            String   @id @default(cuid())
  userId        String
  wabaId        String
  phoneNumberId String   @unique
  displayPhone  String? // ADDED
  accessToken   String // AES-256-GCM ciphertext (see lib/crypto.ts) — never plaintext
  status        String   @default("active") // active | error | disconnected
  createdAt     DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates MessageTemplate[]
  surveys   Survey[]

  @@index([userId])
}

// ADDED: WhatsApp templates are per-WABA, so each connected account needs its own
// copies of the invitation/reminder templates, each with its own approval state.
model MessageTemplate {
  id             String   @id @default(cuid())
  accountId      String
  name           String
  language       String // "fr" | "en"
  category       String   @default("UTILITY")
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | PAUSED
  metaTemplateId String?
  reason         String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  account WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name, language])
}

model Survey {
  id               String           @id @default(cuid())
  userId           String
  title            String
  description      String?
  status           SurveyStatus     @default(draft)
  giftType         GiftType         @default(none)
  giftValue        String? // display label, e.g. "500 MB MTN data bundle"
  giftDeliveryMode GiftDeliveryMode @default(immediate)
  createdAt        DateTime         @default(now())
  publishedAt      DateTime?

  // ADDED
  language         String   @default("fr") // language of participant-facing messages
  customThankYou   String? // referenced by the spec's gift code but missing from its schema
  giftAmount       Int? @map("giftAmountFCFA") // numeric value for airtime / momo gifts, in whole units of the owner's wallet currency
  giftMaxCount     Int? // hard cap on gifts, protects the owner's budget

  // ADDED (automatic reminders). `kind` = general | event; `deadlineAt` is required for events. The two switches are
  // independent and OFF by default: SurveyFlow, not the owner, decides when a reminder is polite (shared/reminders.ts).
  kind                    String    @default("general")
  deadlineAt              DateTime?
  autoRemindNonResponders Boolean   @default(false)
  autoRemindAbandoners    Boolean   @default(false)
  scheduledAt      DateTime?
  closedAt         DateTime?
  whatsappAccountId String?

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  questions  Question[]
  recipients SurveyRecipient[]
  responses  Response[]
  gifts      GiftDelivery[]
  drawEntries PrizeDrawEntry[]
  sheetSync  SheetSync?

  @@index([userId, status])
}

model Question {
  id       String       @id @default(cuid())
  surveyId String
  order    Int
  text     String
  type     QuestionType
  options  Json? // [{ id, label }]
  required Boolean      @default(true)

  survey    Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([surveyId, order])
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String // E.164 with leading "+", e.g. +237677123456
  tags      Json     @default("[]")
  createdAt DateTime @default(now())

  // ADDED: WhatsApp policy requires opt-in; STOP must be honoured.
  consentAt     DateTime?
  consentSource String?
  optedOutAt    DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients  SurveyRecipient[]
  responses   Response[]
  gifts       GiftDelivery[]
  drawEntries PrizeDrawEntry[]

  @@unique([userId, phone])
}

model SurveyRecipient {
  id                  String          @id @default(cuid())
  surveyId            String
  contactId           String
  status              RecipientStatus @default(queued)
  sentAt              DateTime?
  completedAt         DateTime?
  abandonedAtQuestion Int? // 1-based question number

  // ADDED. `status` is strictly FUNNEL progress and never regresses; delivery work
  // (invitations, reminders) lives in SendJob so that re-sending a reminder to an
  // abandoned participant does not erase them from the "abandoned" count.
  startedAt   DateTime?
  lastError   String?
  waMessageId String? // id of the invitation message (delivery status webhooks)
  remindedAt  DateTime?
  createdAt   DateTime @default(now())

  // ADDED (automatic reminders): when the participant was flagged abandoned; which rule produced the reminder
  // (standard | event); whether it was automatic (only automatic reminders get a closing note); when the note went out.
  abandonedAt  DateTime?
  reminderRule String?
  reminderAuto Boolean   @default(false)
  followupAt   DateTime?

  survey  Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  jobs SendJob[]

  @@unique([surveyId, contactId])
  @@index([surveyId, status])
  @@index([waMessageId])
}

// ADDED: DB-backed outbound queue (claimed with FOR UPDATE SKIP LOCKED).
model SendJob {
  id           String    @id @default(cuid())
  userId       String
  recipientId  String?
  kind         String // invitation | reminder | gift_notice | nudge | deadline_note | progress_saved | progress_saved_deadline
  status       String    @default("queued") // queued | processing | done | failed
  scheduledFor DateTime  @default(now())
  attempts     Int       @default(0)
  lastError    String?
  lockedAt     DateTime?
  payload      Json?
  createdAt    DateTime  @default(now())

  recipient SurveyRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
}

model Response {
  id         String   @id @default(cuid())
  surveyId   String
  contactId  String
  questionId String
  answer     String // option label, rating "1".."5", free text, or JSON array for multi
  answeredAt DateTime @default(now())

  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([surveyId, contactId, questionId])
  @@index([questionId])
}

// NOTE: the spec's `Session` lives in Redis only (key sf:sess:{phoneNumberId}:{phone}).
// Durable truth is SurveyRecipient + Response, so a lost Redis can be rebuilt from SQL.

model GiftDelivery {
  id           String     @id @default(cuid())
  surveyId     String
  contactId    String
  giftType     GiftType
  giftValue    String?
  status       GiftStatus @default(pending)
  sentAt       DateTime?
  errorMessage String?

  // ADDED
  amount       Int? @map("amountFCFA") // what the participant receives, in `currency`
  currency     String   @default("XAF") // the owner's wallet currency when the gift was paid
  payoutXAF    Int? // the same amount in CFA francs at the live rate when it was debited: what the payout provider is asked to send
  code         String? // discount code
  providerRef  String?
  attempts     Int      @default(0)
  scheduledFor DateTime @default(now())
  createdAt    DateTime @default(now())

  // ADDED (gift wallet)
  fee               Int       @default(0) @map("feeFCFA") // pass-through fee charged to the owner's wallet on top of `amount` (same currency)
  refundedAt        DateTime? // set when a DEFINITE failure returned amount+fee to the wallet (ambiguous failures stay debited)
  notifyViaTemplate Boolean   @default(false) // released after a top-up: the 24h window is closed, so notify with a template

  survey  Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // One gift per participant per survey — gifts move real money, so double delivery
  // from a retried webhook must be impossible at the database level.
  @@unique([surveyId, contactId])
  @@unique([surveyId, code])
  @@index([status, scheduledFor])
}

// ADDED: the spec's `db.addToDrawPool`.
model PrizeDrawEntry {
  id        String   @id @default(cuid())
  surveyId  String
  contactId String
  isWinner  Boolean  @default(false)
  createdAt DateTime @default(now())

  survey  Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([surveyId, contactId])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  plan               Plan
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  paymentMethod      String? // mobile_money | card | bank_transfer
  amountFCFA         Int                @default(0)
  pspProvider        String?
  pspTransactionId   String?

  // ADDED
  interval          String    @default("monthly") // monthly | annual
  cancelAtPeriodEnd Boolean   @default(false)
  graceEndsAt       DateTime?
  reminderSentAt    DateTime? // "your plan renews in 3 days" notice sent for this period (reset by every payment)
  pastDueNoticeAt   DateTime? // "payment overdue, renew before …" notice sent for this lapse (reset by every payment)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id             String            @id @default(cuid())
  subscriptionId String
  pspProvider    String
  amount         Int
  currency       String
  status         TransactionStatus @default(pending)
  pspReference   String?
  createdAt      DateTime          @default(now())

  // ADDED
  userId      String
  reference   String   @unique // our internal id sent to the PSP
  purpose     String   @default("subscription") // subscription | gift_topup
  plan        Plan? // null for gift top-ups
  interval    String   @default("monthly")
  method      String // mobile_money | card | bank_transfer
  phone       String?
  checkoutUrl String?
  paidAt      DateTime?
  failReason  String?
  // ADDED (multi-currency): the plan / top-up value in CFA francs at initiation, and the live rate used (null for CFA payments).
  amountXAF Int?
  fxRate    Float?
  // ADDED (reconciliation): when the provider was last asked about this payment, and every provider we tried to start it at
  // ([{psp, at, ok, ambiguous?, error?}]) — the trail an operator needs when "did the customer pay?" is the question.
  lastCheckedAt DateTime?
  attempts      Json?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([pspProvider, pspReference])
  @@index([status, createdAt])
}

// ADDED: append-only ledger of the gift wallet (audit trail; the balance itself lives on User).
// Idempotency comes from the guarded state transitions that create entries (payment pending→success,
// gift pending→failed, gift unfunded→pending), not from this table.
model WalletEntry {
  id           String   @id @default(cuid())
  userId       String
  delta        Int    @map("deltaFCFA") // + top-up / refund, − gift debit, in the owner's wallet currency
  balanceAfter Int
  kind         String // topup | gift_debit | gift_refund
  refId        String? // PaymentTransaction.id or GiftDelivery.id
  note         String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([refId]) // heldByGift(): a refund sums the ledger rows of ONE gift
}

// ADDED: one row per business-initiated (template) message. This is the unit the
// plan's "WhatsApp messages / month" quota counts — free-form replies inside the
// 24h service window are not counted.
model MessageLog {
  id          String   @id @default(cuid())
  userId      String
  kind        String // invitation | reminder | gift
  waMessageId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ADDED: Google Sheets OAuth.
model GoogleConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  email        String?
  refreshToken String // AES-256-GCM ciphertext
  scope        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SheetSync {
  id            String    @id @default(cuid())
  surveyId      String    @unique
  userId        String
  spreadsheetId String
  spreadsheetUrl String
  autoSync      Boolean   @default(false)
  lastSyncedAt  DateTime?
  rowsSynced    Int       @default(0)
  createdAt     DateTime  @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ADDED: which participants were already appended to the sheet (idempotent re-sync).
model SheetRow {
  id        String   @id @default(cuid())
  surveyId  String
  contactId String
  createdAt DateTime @default(now())

  @@unique([surveyId, contactId])
}

// ADDED: live exchange rates, XAF -> currency (units of the currency per 1 XAF). Redis is the hot cache; this table is the
// last-known-good copy used when the rate source is down (and its age decides whether it may still be used).
model FxRate {
  currency        String   @id
  rate            Float
  sourceUpdatedAt DateTime? // when the rate source published it
  fetchedAt       DateTime @default(now())
}

// ADDED (Explore/Activate): the first time each milestone happens for an owner, so the first weeks of real sign-ups show where people stop
// (signup → whatsapp_connected → first_send → first_response → paywall_view → checkout_start → paid). One row per (owner, milestone).
model FunnelEvent {
  id        String   @id @default(cuid())
  userId    String
  name      String
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([name, createdAt])
}

// ADDED (Analytics Bot): a phone that has been proven to belong to this owner by sending a one-time code (LINK <code>) to the SurveyFlow
// number. Only linked phones may ask for numbers; a phone belongs to ONE account; at most 3 per account. `phone` is the WhatsApp id (digits).
model OwnerPhone {
  id        String   @id @default(cuid())
  userId    String
  phone     String   @unique
  /** Milestone and slowdown alerts to this phone (MUTE / ALERTS ON, or the switch in Settings). */
  alerts    Boolean  @default(true)
  /** Last message this phone sent to SurveyFlow's number: an alert inside the following 24 h is a free reply, outside it needs a template. */
  lastInboundAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * One row per alert decided for an owner: the unique key makes a milestone / weekly slowdown fire ONCE however many completions race,
 * and the rows are what the template caps (per day / per month) count.
 */
model BotAlert {
  id          String   @id @default(cuid())
  userId      String
  surveyId    String
  kind        String
  /** "100" for a milestone, "2026-W42" for a slowdown. */
  key         String
  /** 'window' (free reply), 'template' (billed to SurveyFlow), 'skipped' (muted / capped / no phone). */
  channel     String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([surveyId, kind, key])
  @@index([userId, createdAt])
}
