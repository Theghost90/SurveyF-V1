{
  "name": "@surveyflow/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push --skip-generate --accept-data-loss && prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.16.0",
    "@surveyflow/shared": "*",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "nanoid": "^5.0.0",
    "nodemailer": "^10.2.1",
    "prisma": "^6.16.0",
    "puppeteer": "^25.16.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^11.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
