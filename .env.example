# ───────────── SurveyFlow V1 — environment ─────────────
# Copy to .env (never commit it). Variables marked (+) are NOT in the original spec list but are required.

# --- Core ---
DATABASE_URL=postgresql://surveyflow:surveyflow@127.0.0.1:5432/surveyflow
REDIS_URL=redis://127.0.0.1:6379
NODE_ENV=development
PORT=4223
WEB_ORIGIN=http://localhost:4222            # (+) CORS origin(s) of the web app
PUBLIC_API_URL=http://localhost:4223        # (+) public URL of the API (PSP webhooks / Meta webhook)

# --- Secrets (+) ---
JWT_SECRET=                                 # (+) >= 32 chars; signs API access tokens
TOKEN_ENCRYPTION_KEY=                       # (+) 32 bytes, base64 or hex; encrypts WhatsApp/Google tokens at rest (openssl rand -base64 32)
INTERNAL_API_SECRET=                        # (+) shared secret between the website server and the API (openssl rand -base64 36), same value in both. When set, the API refuses every call without it except Meta/PSP webhooks, receipts and /healthz. REQUIRED in production.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:4222
API_URL=http://localhost:4223               # (+) server-side URL the Next.js app uses to reach the API

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_MODE=mock                          # (+) mock = local simulator, live = real Meta. Production requires live.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=                            # (+) REQUIRED in live mode: verifies X-Hub-Signature-256 on every webhook
META_APP_ID=                                # (+) Embedded Signup
META_EMBEDDED_SIGNUP_CONFIG_ID=             # (+) Embedded Signup
NEXT_PUBLIC_META_APP_ID=                    # (+) same as META_APP_ID, for the browser SDK
NEXT_PUBLIC_META_CONFIG_ID=                 # (+) same as META_EMBEDDED_SIGNUP_CONFIG_ID
SESSION_TIMEOUT_HOURS=24

# --- Payments (Section 9 of the spec) ---
PSP_MOCK=true                               # (+) demo checkout, NO real money. Refused in production.
NOTCHPAY_API_KEY=
NOTCHPAY_WEBHOOK_HASH=                      # (+)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=                        # (+)
CAMPAY_API_KEY=
CAMPAY_APP_ID=
CAMPAY_ENV=demo                             # (+) demo | prod
CAMPAY_WEBHOOK_KEY=                         # (+)
PAYUNIT_API_KEY=
PAYUNIT_API_USERNAME=                       # (+) PayUnit needs a username as well as the password
PAYUNIT_API_PASSWORD=
PAYUNIT_MODE=test                           # (+) test | live
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=                   # (+) secret hash configured in the Flutterwave dashboard

# --- Gifts ---
GIFT_PROVIDER=mock                          # (+) mock | campay. Production requires campay.
GIFT_FEE_PERCENT=5                          # (+) pass-through fee on each airtime/MoMo gift, charged to the OWNER's wallet. PLACEHOLDER: set from real tariffs.

# --- Payment routing, exchange rates & geolocation (+) ---
PSP_FEES=                                   # (+) optional overrides of the documented provider fees (docs/DECISIONS.md §3.3 table), e.g. {"campay":{"mobile_money":1.8},"notchpay":{"card":{"percent":3.9,"fixed":0.3,"fixedCurrency":"USD"}}}. A number = percent. The cheapest provider per payment is chosen silently.
CAMERPAY_API_KEY=                           # (+) CamerPay (camerpay.biz): Bearer token from the dashboard (API)
CAMERPAY_WEBHOOK_SECRET=                    # (+) CamerPay's "callback secret": webhooks are HMAC-SHA256 signed with it. Without BOTH variables CamerPay is not offered.
CAMERPAY_BASE_URL=https://camerpay.biz      # (+)
CAMERPAY_PLAN=starter                       # (+) starter | business | pro | byok: your CamerPay plan, which decides its mobile-money fee in the ranking (3.0 / 1.5 / 1.0 / 0 %)
FX_API_URL=https://open.er-api.com/v6/latest/XAF  # (+) live rates FCFA -> visitor currency (ExchangeRate-API open endpoint: no key, daily, attribution shown on converted prices). For offline demos: node scripts/fx-stub.mjs and FX_API_URL=http://127.0.0.1:4299/v6/latest/XAF
FX_CACHE_MINUTES=360                        # (+) how long a fetched rate table is reused
FX_MAX_STALE_HOURS=72                       # (+) a rate older than this is NOT used: prices fall back to FCFA
DEV_GEO_COUNTRY=                            # (+) local testing ONLY (e.g. NG, KE, GH, CI): pretend every visitor is there. Works with `npm run dev` ONLY: `npm start` / a production build ignores it. Needs a restart, and a reachable exchange-rate source (FX_API_URL) or prices stay in FCFA. Real detection reads the CDN's country header.

# --- Google (Sheets + optional sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4222/integrations/google/callback   # (+)

# --- Billing policy ---
TRIAL_EXPIRY_POLICY=starter                 # (+) starter (spec: downgrade, effectively a free tier) | suspend

# --- PDF export ---
PUPPETEER_EXECUTABLE_PATH=                  # (+) path to Chromium/Chrome (Docker/Fly/Railway images)
