# ───────────── SurveyFlow V1 — environment ─────────────
# Copy to .env (never commit it). Variables marked (+) are NOT in the original spec list but are required.

# --- Core ---
DATABASE_URL=postgresql://surveyflow:surveyflow@127.0.0.1:5432/surveyflow
REDIS_URL=redis://127.0.0.1:6379
NODE_ENV=development
PORT=4223
WEB_ORIGIN=http://localhost:4222            # (+) CORS origin(s) of the web app
PUBLIC_API_URL=http://localhost:4223        # (+) public URL of the API (PSP webhooks / Meta webhook)

# --- Secrets (+) ---
JWT_SECRET=                                 # (+) >= 32 chars; signs API access tokens
TOKEN_ENCRYPTION_KEY=                       # (+) 32 bytes, base64 or hex (openssl rand -base64 32). The ORIGINAL encryption key: still decrypts what was written with it. New deployments: set ENCRYPTION_KEYS below instead (either one satisfies the production check).
INTERNAL_API_SECRET=                        # (+) shared secret between the website server and the API (openssl rand -base64 36), same value in both. When set, the API refuses every call without it except Meta/PSP webhooks, receipts and /healthz. REQUIRED in production.
NEXTAUTH_SECRET=                            # (+) signs the website's session cookie. Leave it blank for a local preview (`npm run dev` uses a throw-away one); REQUIRED in production, where a blank one means nobody can sign in (openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:4222
API_URL=http://localhost:4223               # (+) server-side URL the Next.js app uses to reach the API

# --- Sign-in & data protection (+) — what each one does: docs/SECURITY.md ---
PUBLIC_WEB_URL=                             # (+) the website's public address: the links in confirmation / password-reset e-mails are built from it. Default: the first WEB_ORIGIN. Production requires https and a real domain.
EMAIL_PROVIDER=                             # (+) mock | smtp | resend | brevo. Default: mock outside production (mails are kept in a local mailbox and shown on the "check your e-mail" page, never sent). Production refuses to start with mock.
EMAIL_FROM=SurveyFlow <no-reply@surveyflow.local>   # (+) sender shown to people. Production needs an address you have verified with your e-mail provider.
SMTP_URL=                                   # (+) smtps://user:password@smtp.example.com:465   (EMAIL_PROVIDER=smtp)
RESEND_API_KEY=                             # (+) EMAIL_PROVIDER=resend
BREVO_API_KEY=                              # (+) EMAIL_PROVIDER=brevo
TURNSTILE_SITE_KEY=                         # (+) Cloudflare Turnstile (free CAPTCHA, dash.cloudflare.com -> Turnstile). Shown only after repeated failures and at sign-up. Both keys, or CAPTCHA_DISABLED=true.
TURNSTILE_SECRET_KEY=                       # (+)
CAPTCHA_DISABLED=                           # (+) true = run production without a CAPTCHA on purpose (the delays between attempts still apply)
HIBP_CHECK=                                 # (+) true (default; false in tests) = refuse passwords known from breaches via haveibeenpwned.com (only 5 characters of a hash leave the server; a slow or down service never blocks anyone)
ENCRYPTION_KEYS=                            # (+) key ring for data encrypted at rest: kid:key,kid:key (each key 32 bytes, base64 or hex). The FIRST encrypts, the others only decrypt. Rotate with scripts/rotate-keys.mts. Replaces TOKEN_ENCRYPTION_KEY (which still decrypts older data).
BLIND_INDEX_KEY=                            # (+) 32 bytes (openssl rand -base64 32): the secret of the number index that lets a participant be found again without the number being readable. REQUIRED in production. Changing it means re-hashing every contact (scripts/rotate-keys.mts --rehash-index).
JWT_SECRET_PREVIOUS=                        # (+) retired signing secrets, comma-separated: rotate by moving the old JWT_SECRET here; sessions survive until their tokens expire
ACCESS_TOKEN_TTL_SECONDS=900                # (+) lifetime of the API token (the website renews it silently from the refresh token)
SESSION_TTL_HOURS=12                        # (+) absolute life of a sign-in; after it the owner signs in again
ARGON2_MEMORY_KIB=19456                     # (+) password hashing cost (OWASP minimum: 19 MiB, 2 passes). Raise it if the server can afford it.
ARGON2_TIME_COST=2                          # (+)
EXPORT_DAILY_LIMIT=20                       # (+) participant-data downloads per owner per rolling day
EXPORT_DAILY_ROWS=50000                     # (+) participant rows leaving the account per owner per rolling day
STEP_UP_EXPORT_ROWS=50                      # (+) a download of at least this many rows asks the owner to "confirm it is you"
STEP_UP_BULK_ROWS=20                        # (+) so does deleting MORE than this many contacts at once
STEP_UP_MINUTES=15                          # (+) how long a confirmation counts
REVEAL_PER_DAY=300                          # (+) full phone numbers an owner can reveal per rolling day (numbers are masked in lists)
REQUIRE_2FA_PLANS=business                  # (+) plans (comma-separated) whose owners must switch on an authenticator app before exporting or deleting in bulk
AUDIT_RETENTION_DAYS=400                    # (+) how long the security log is kept
UNVERIFIED_PURGE_HOURS=24                   # (+) an account whose e-mail was never confirmed is deleted after this many hours
ACCOUNT_DELETION_GRACE_DAYS=30              # (+) days between "delete my account" and the erasure (the account only reads meanwhile; the owner can cancel)
FINANCIAL_RETENTION_YEARS=10                # (+) how long the money record (no name, number or e-mail) outlives a deleted account. A default for counsel to confirm, not a legal statement
ACCOUNT_EXPORT_PER_DAY=3                    # (+) whole-account downloads per owner per rolling day
SIGNUP_PER_IP_HOUR=30                       # (+) sign-ups per connection per hour. Generous on purpose: on a mobile network many subscribers share one public address, and the CAPTCHA does the real work.
RATE_LIMIT_SESSION_PER_MINUTE=300           # (+) general API limit per SIGN-IN SESSION (calls with no valid token count per address): many owners can share one public address
RATE_LIMIT_IP_PER_MINUTE=3000               # (+) ceiling per ADDRESS whatever sessions it carries: one source cannot flood the API with many sessions
CONFIRM_REQUIRES_PASSWORD=true              # (+) the e-mail confirmation page asks for the password chosen at sign-up (a stranger who signed up with someone else's address cannot get it confirmed by that person's click). false = the link alone confirms.
READ_SOFT_PEOPLE=1000                       # (+) DIFFERENT participants whose names or answers one login lists in 24 h before a "confirm it is you" is needed (and the owner is e-mailed once)
READ_HARD_PEOPLE=20000                      # (+) ...and the number past which the lists stop until the window has passed (a download, capped and confirmed too, is the way to take more)
SHEETS_AUTOSYNC_DAYS=30                     # (+) Google Sheets auto-sync pauses this many days after the owner last confirmed it ("confirm it is you" is needed to turn it on or confirm again)

# --- Website server only (apps/web) (+) ---
CLIENT_IP_HEADER=                           # (+) the header your CDN / proxy sets to the visitor's REAL address, e.g. cf-connecting-ip (Cloudflare) or x-real-ip. Without it (or TRUSTED_PROXY_HOPS) the sign-in limits cannot tell visitors apart.
TRUSTED_PROXY_HOPS=                         # (+) alternative to CLIENT_IP_HEADER: how many proxies of yours sit in front of the website; the visitor is the Nth address from the right of x-forwarded-for
CSP_MODE=                                   # (+) enforce (default) | report-only | off: the Content-Security-Policy that blocks injected scripts

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_MODE=mock                          # (+) mock = local simulator, live = real Meta. Production requires live.
WHATSAPP_PLATFORM_PHONE=                    # SurveyFlow's own WhatsApp number (digits, e.g. 237600000001): the Analytics Bot answers from it. Mock mode has a default
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=                            # (+) REQUIRED in live mode: verifies X-Hub-Signature-256 on every webhook
META_APP_ID=                                # (+) Embedded Signup
META_EMBEDDED_SIGNUP_CONFIG_ID=             # (+) Embedded Signup
NEXT_PUBLIC_META_APP_ID=                    # (+) same as META_APP_ID, for the browser SDK
NEXT_PUBLIC_META_CONFIG_ID=                 # (+) same as META_EMBEDDED_SIGNUP_CONFIG_ID
SESSION_TIMEOUT_HOURS=24

# --- Payments (Section 9 of the spec) ---
PSP_MOCK=true                               # (+) demo checkout, NO real money. Refused in production.
NOTCHPAY_API_KEY=
NOTCHPAY_WEBHOOK_HASH=                      # (+)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=                        # (+)
CAMPAY_API_KEY=
CAMPAY_APP_ID=
CAMPAY_ENV=demo                             # (+) demo | prod
CAMPAY_WEBHOOK_KEY=                         # (+)
PAYUNIT_API_KEY=
PAYUNIT_API_USERNAME=                       # (+) PayUnit needs a username as well as the password
PAYUNIT_API_PASSWORD=
PAYUNIT_MODE=test                           # (+) test | live
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=                   # (+) secret hash configured in the Flutterwave dashboard

# --- Gifts ---
GIFT_PROVIDER=mock                          # (+) mock | campay. Production requires campay.
GIFT_FEE_PERCENT=5                          # (+) pass-through fee on each airtime/MoMo gift, charged to the OWNER's wallet. PLACEHOLDER: set from real tariffs.

# --- Payment routing, exchange rates & geolocation (+) ---
PSP_FEES=                                   # (+) optional overrides of the documented provider fees (docs/DECISIONS.md §3.3 table), e.g. {"campay":{"mobile_money":1.8},"notchpay":{"card":{"percent":3.9,"fixed":0.3,"fixedCurrency":"USD"}}}. A number = percent. The cheapest provider per payment is chosen silently.
CAMERPAY_API_KEY=                           # (+) CamerPay (camerpay.biz): Bearer token from the dashboard (API)
CAMERPAY_WEBHOOK_SECRET=                    # (+) CamerPay's "callback secret": webhooks are HMAC-SHA256 signed with it. Without BOTH variables CamerPay is not offered.
CAMERPAY_BASE_URL=https://camerpay.biz      # (+)
CAMERPAY_PLAN=starter                       # (+) starter | business | pro | byok: your CamerPay plan, which decides its mobile-money fee in the ranking (3.0 / 1.5 / 1.0 / 0 %)
FX_API_URL=https://open.er-api.com/v6/latest/XAF  # (+) live rates FCFA -> visitor currency (ExchangeRate-API open endpoint: no key, daily, attribution shown on converted prices). For offline demos: node scripts/fx-stub.mjs and FX_API_URL=http://127.0.0.1:4299/v6/latest/XAF
FX_CACHE_MINUTES=360                        # (+) how long a fetched rate table is reused
FX_MAX_STALE_HOURS=72                       # (+) a rate older than this is NOT used: prices fall back to FCFA
SF_DEMO=                                    # (+) 1 = shared test instance: shows a "test environment" notice and keeps the Simulator in a production build. Set by `npm run share`; leave empty otherwise.
DEV_GEO_COUNTRY=                            # (+) local testing ONLY (e.g. NG, KE, GH, CI): pretend every visitor is there. Works with `npm run dev` ONLY: `npm start` / a production build ignores it. Needs a restart, and a reachable exchange-rate source (FX_API_URL) or prices stay in FCFA. Real detection reads the CDN's country header.

# --- Google (Sheets + optional sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4222/integrations/google/callback   # (+)

# --- Billing policy ---

# --- PDF export ---
PUPPETEER_EXECUTABLE_PATH=                  # (+) path to Chromium/Chrome (Docker/Fly/Railway images)
